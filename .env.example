# Postgres connection string. On Railway, set this to ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Comma-separated usernames that get Demo controls, Pilot metrics and Reset
ADMIN_USERNAMES=andrew
# Only needed if your database requires SSL from outside Railway's private network
PGSSL=false

# ---- Real-money site only (my.pocketinvesting.com) ----
# SITE_MODE=live
# ALPACA_KEY=        (Alpaca Client ID; also set on the demo service for news and the stock list)
# ALPACA_SECRET=     (Alpaca Client Secret)
# ALPACA_AUTH_MODE=token   (use 'legacy' only for older key pairs)
# ALPACA_ENV=sandbox
# APP_SECRET=a-long-random-string-you-never-change
# MAX_ORDER_USD=25000
# Instant deposits (built, off until you turn it on):
# INSTANT_DEPOSITS=false
# ALPACA_FIRM_ACCOUNT_ID=
# INSTANT_LIMIT=1000
# INSTANT_TOTAL_CAP=25000
# INSTANT_MIN_ACCOUNT_DAYS=30

# ---- News from SEC filings (both sites) ----
# SEC_FILINGS=auto       (auto: only while Alpaca news isn't available; on; off)
# SEC_CONTACT=Your Name you@example.com
